NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never rename this with a NEXT_PUBLIC_ prefix or expose its value in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Server-only Gmail SMTP credentials. Use a Google App Password, not your Gmail password.
GMAIL_USER=your-gmail-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
# Generate a long random value and configure the same value in the deployment environment.
CRON_SECRET=replace-with-a-long-random-secret
# Buyer and seller accounts are stored separately in public.website_accounts.
# Create admin accounts in Supabase Auth and set their public.profiles role to admin.
