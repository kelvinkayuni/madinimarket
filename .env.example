NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Never rename this with a NEXT_PUBLIC_ prefix or expose its value in the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Buyer and seller accounts are stored separately in public.website_accounts.
# Create admin accounts in Supabase Auth and set their public.profiles role to admin.
